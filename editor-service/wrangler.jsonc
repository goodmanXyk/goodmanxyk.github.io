{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "wanwu-editor",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "vars": {
    "GITHUB_OWNER": "goodmanXyk",
    "GITHUB_REPO": "goodmanxyk.github.io",
    "GITHUB_BRANCH": "main",
    "ALLOWED_GITHUB_LOGIN": "goodmanXyk"
  }
}
